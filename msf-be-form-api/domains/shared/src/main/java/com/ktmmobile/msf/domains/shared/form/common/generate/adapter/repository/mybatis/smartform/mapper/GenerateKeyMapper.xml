<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ktmmobile.msf.domains.shared.form.common.generate.adapter.repository.mybatis.smartform.mapper.GenerateKeyMapper">

  <select id="selectGeneratedResNo" resultType="string">
    <!--SELECT NEXTVAL('SQ_REQUEST_RES_NO_KEY')-->
    SELECT ( TO_CHAR(NOW(), 'YYYYMMDD') || LPAD(NEXTVAL('SQ_REQUEST_RES_NO_KEY')::TEXT, 5, '0'))
  </select>

  <select id="selectGeneratedRequestKey" resultType="long">
    SELECT NEXTVAL('SQ_REQUEST_KEY')
    <!--    SELECT ( TO_CHAR(NOW(), 'YYYYMMDD') || LPAD(NEXTVAL('SQ_REQUEST_KEY')::TEXT, 5, '0'))-->
  </select>

  <select id="selectGeneratedCustRequestSeq" resultType="long">
    <!--SELECT NEXTVAL('SQ_NFL_CHG_TRNS_SEQ')-->
    SELECT ( TO_CHAR(NOW(), 'YYYYMMDD') || LPAD(NEXTVAL('SQ_NFL_CHG_TRNS_SEQ')::TEXT, 5, '0'))
  </select>

  <select id="selectGeneratedRequestStateSeq" resultType="java.lang.Long">
    SELECT NEXTVAL('SQ_REQUEST_STATE_SEQ')
    <!--SELECT ( TO_CHAR(NOW(), 'YYYYMMDD') || LPAD(NEXTVAL('SQ_REQUEST_STATE_SEQ')::TEXT, 5, '0'))-->
  </select>
</mapper>