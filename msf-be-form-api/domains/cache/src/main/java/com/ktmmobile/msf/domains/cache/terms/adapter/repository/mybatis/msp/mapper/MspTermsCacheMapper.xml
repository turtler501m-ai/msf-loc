<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ktmmobile.msf.domains.cache.terms.adapter.repository.mybatis.msp.mapper.MspTermsCacheMapper">

  <resultMap id="termsDetail" type="com.ktmmobile.msf.domains.cache.terms.domain.entity.TermsDetail">
    <id property="seq" column="SEQ" />
    <result property="cdGroupId1" column="CD_GROUP_ID1" />
    <result property="cdGroupId2" column="CD_GROUP_ID2" />
    <collection property="contents" javaType="list" ofType="com.ktmmobile.msf.domains.cache.terms.domain.entity.TermsDetailContent">
      <id property="docVer" column="DOC_VER" />
      <result property="docContent" column="DOC_CONTENT" javaType="string" jdbcType="CLOB" />
      <result property="useYn" column="USE_YN" />
      <result property="eventStartDt" column="EVENT_START_DT" />
      <result property="eventEndDt" column="EVENT_END_DT" />
      <result property="eventStartDtSec" column="EVENT_START_DT_SEC" />
      <result property="eventEndDtSec" column="EVENT_END_DT_SEC" />
      <result property="startHour" column="START_HOUR" />
      <result property="endHour" column="END_HOUR" />
      <result property="startHourSec" column="START_HOUR_SEC" />
      <result property="endHourSec" column="END_HOUR_SEC" />
      <result property="docContentSec" column="DOC_CONTENT_SEC" javaType="string" jdbcType="CLOB" />
      <result property="docType" column="DOC_TYPE" />
      <result property="expnsnStrVal" column="EXPNSN_STR_VAL" />
    </collection>
  </resultMap>
  <select id="selectListTermsDetail" resultMap="termsDetail">
    SELECT SEQ
         , CD_GROUP_ID1
         , CD_GROUP_ID2
         , DOC_VER
         , DOC_CONTENT
         , USE_YN
         , EVENT_START_DT
         , EVENT_END_DT
         , EVENT_START_DT_SEC
         , EVENT_END_DT_SEC
         , START_HOUR
         , END_HOUR
         , START_HOUR_SEC
         , END_HOUR_SEC
         , DOC_CONTENT_SEC
         , DOC_TYPE
         , EXPNSN_STR_VAL
      FROM
    <foreach collection="list" item="item" index="index" open="(" close=")" separator=" union all ">
           SELECT SEQ
                , CD_GROUP_ID1
                , CD_GROUP_ID2
                , DOC_VER
                , DOC_CONTENT
                , USE_YN
                , EVENT_START_DT
                , EVENT_END_DT
                , EVENT_START_DT_SEC
                , EVENT_END_DT_SEC
                , START_HOUR
                , END_HOUR
                , START_HOUR_SEC
                , END_HOUR_SEC
                , DOC_CONTENT_SEC
                , DOC_TYPE
                , EXPNSN_STR_VAL
             FROM NMCP_FORM_DTL@DL_MCP
            WHERE CD_GROUP_ID1 = #{item.cdGroupId1}
              AND CD_GROUP_ID2 = #{item.cdGroupId2}
    </foreach>
  </select>
</mapper>